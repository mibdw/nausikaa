    "./nausikaa.min.css": "./dist/nausikaa.min.css",
    "./icons.svg": "./images/icons.svg",
    "./calendar": "./dist/calendar.js",
    "./date-picker": "./dist/date-picker.js",
    "./editor": "./dist/editor.js",
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles",
    "images",
    "utilities",
    "THIRD-PARTY-NOTICES.md"
