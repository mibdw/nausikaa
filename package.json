{
  "type": "module",
  "name": "nausikaa",
  "version": "1.1.0",
  "description": "CSS building blocks for accessible websites: one stylesheet that styles plain HTML, with light, dark and e-ink themes.",
  "main": "dist/nausikaa.min.css",
  "style": "dist/nausikaa.min.css",
  "exports": {
    ".": {
      "style": "./dist/nausikaa.min.css",
