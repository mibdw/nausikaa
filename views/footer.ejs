<%# The foot of every page: where to go next, and the facts about Nausikaä itself.
    The numbers come from routes.js, the links from navigation.js. %>
<%
  var documentation = nav.find(function (l) { return l.slug == 'documentation'; });
  var examples = nav.find(function (l) { return l.slug == 'examples'; });
%>
<footer class="site-footer">
  <%# A town along the bottom edge, of which the roofs show, and houses up the sides; /scripts/townscape.js draws them %>
  <div class="site-footer-towns"><div class="townscape" data-townscape data-townscape-floor="0.9" aria-hidden="true"></div></div>

  <div class="site-footer-about">
    <a href="/" class="site-footer-brand">
      <img src="/images/nausikaa.png" alt="" width="40" height="40">
      <strong>Nausikaä</strong>
    </a>
    <p>CSS building blocks for accessible websites. One stylesheet, no JavaScript, free for everyone.</p>
  </div>

  <nav aria-label="Documentation">
    <h2>Documentation</h2>
    <ul>
      <% documentation.nav.forEach(function (group) { %>
      <li><a href="/documentation#<%= group.slug %>"><%= group.title %></a></li>
      <% }); %>
    </ul>
  </nav>

  <nav aria-label="Examples">
    <h2>Examples</h2>
    <ul>
      <% examples.nav.forEach(function (example) { %>
      <li><a href="/examples/<%= example.slug %>"><%= example.title %></a></li>
      <% }); %>
    </ul>
  </nav>

  <nav aria-label="Project">
    <h2>Project</h2>
    <ul>
      <li><a href="/documentation/foundations/getting-started">Getting started</a></li>
      <li><a href="/download">Download</a></li>
      <li><a href="https://github.com/mibdw/nausikaa">Source on GitHub</a></li>
      <li><a href="/documentation/foundations/accessibility/#limitations">Known limitations</a></li>
      <li><a href="mailto:ben@mibdw.club">Contact</a></li>
    </ul>
  </nav>

  <p class="site-footer-facts">
    <span>Version <%= site.version %></span>
    <% if (site.gzipped) { %><span>Stylesheet of <%= site.gzipped %> kB gzipped</span><% } %>
    <span>Made by MIBDW</span>
  </p>
</footer>

<%# Draws the towns of this page: here in the footer, and in the sections of the frontpage and the overviews %>
<script src="/scripts/townscape.js" defer></script>
