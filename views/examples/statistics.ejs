<%
  // Example: statistics about orders. The location, the filters and the
  // periods of the two top lists are all in the address, so they work with
  // plain links and forms. data.statisticsView() counts what to show.
  var view = data.statisticsView(query);
  var number = function (n) { return n.toLocaleString('en'); };

  // A record's own number, with the location it belongs to
  var identifier = function (item) {
    return '<span class="tag ' + data.branches[item.branch].color + '" title="' + data.branches[item.branch].name + '"><strong>' + item.branch + '</strong></span> ' +
      '<span class="tag">' + item.id + '</span>';
  };

  // What a form has to send along to keep the rest of the address
  var keep = function (except) {
    var fields = [];
    if (view.location && except != 'filters') fields.push(['location', view.location]);
    if (except != 'filters') view.facets.forEach(function (facet) { view.filters[facet.key].forEach(function (value) { fields.push([facet.key, value]); }); });
    if (except != 'product-period' && view.periods.products != '30d') fields.push(['product-period', view.periods.products]);
    if (except != 'publisher-period' && view.periods.publishers != '30d') fields.push(['publisher-period', view.periods.publishers]);
    return fields;
  };

  // The line chart: six lines of twelve months on one scale
  var chart = { width: 560, height: 140, top: 12, right: 8, bottom: 28, left: 36 };
  chart.innerWidth = chart.width - chart.left - chart.right;
  chart.innerHeight = chart.height - chart.top - chart.bottom;
  chart.highest = Math.max.apply(null, view.series.map(function (line) { return Math.max.apply(null, line.points.map(function (point) { return point.count; })); }).concat(1));
  var x = function (i) { return +(chart.left + i * chart.innerWidth / 11).toFixed(2); };
  var y = function (count) { return +(chart.top + chart.innerHeight - count / chart.highest * chart.innerHeight).toFixed(2); };

  var highestStatus = view.byStatus.length ? view.byStatus[0].count : 1;
  var highestGroup = view.byGroup.length ? view.byGroup[0].count : 1;
  var highestYear = Math.max.apply(null, view.byYear.map(function (year) { return year.count; }).concat(1));

  // One of the two top lists, with its own period
  var topList = function (title, name, period, items, nameOf) {
    return '<section class="stat-top-list">' +
      '<form class="stat-top-header" action="/examples/statistics" method="GET">' +
      '<h3>' + title + '</h3>' +
      keep(name).map(function (field) { return '<input type="hidden" name="' + field[0] + '" value="' + esc(field[1]) + '">'; }).join('') +
      '<select name="' + name + '" aria-label="Period of ' + title.toLowerCase() + '" data-submit>' +
      view.periodOptions.map(function (option) { return '<option value="' + option[0] + '"' + (option[0] == period ? ' selected' : '') + '>' + option[1] + '</option>'; }).join('') +
      '</select><noscript><button type="submit">Show</button></noscript></form>' +
      (items.length
        ? '<ol class="stat-top-ol">' + items.map(function (item, i) {
            return '<li><span class="stat-top-rank">' + (i + 1) + '</span>' +
              '<a href="' + view.url() + '" class="stat-top-customer">' + identifier(item) + ' <span class="stat-top-name">' + esc(nameOf(item)) + '</span></a>' +
              '<span class="stat-top-value">' + number(item.value) + '</span></li>';
          }).join('') + '</ol>'
        : '<p class="stat-top-empty">No data for this period.</p>') +
      '</section>';
  };
  var esc = function (text) { return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;'); };
%>
<main id="statistics">

  <nav class="tabs" aria-label="Statistics">
    <ul>
      <li class="title tabs-title"><span>📊 Statistics</span></li>
      <li><a href="<%= view.url() %>">👥 Customers</a></li>
      <li><a href="<%= view.url() %>">🚚 Publishers / Suppliers</a></li>
      <li class="active"><a href="<%= view.url() %>" aria-current="page">📦 Orders</a></li>
      <li><a href="<%= view.url() %>">🌟 NTS / Approval plans</a></li>
    </ul>
  </nav>

  <aside class="statistics-sidebar">
    <%# One form holds all filters. It is sent as soon as one changes; the
        button is for visitors without JavaScript. %>
    <form action="/examples/statistics" method="GET" id="statistics-filters">
      <% keep('filters').forEach(function (field) { %><input type="hidden" name="<%= field[0] %>" value="<%= field[1] %>"><% }); %>

      <div class="panel blue">
        <ul class="radios">
          <li>
            <input type="radio" id="loc-all" name="location" value="" <%= view.location ? '' : 'checked' %>>
            <label for="loc-all">All locations</label>
          </li>
          <% view.locations.forEach(function (option) { %>
          <li>
            <input type="radio" id="loc-<%= option.key %>" name="location" value="<%= option.key %>" <%= view.location == option.key ? 'checked' : '' %>>
            <label for="loc-<%= option.key %>">
              <span><span class="tag <%= option.color %>"><strong><%= option.key %></strong></span> <%= option.name %></span>
              <span><%= number(option.count) %></span>
            </label>
          </li>
          <% }); %>
          <% if (view.location) { %>
          <li class="seperator"></li>
          <li><a href="<%= view.url({ location: '' }) %>">Clear location filter</a></li>
          <% } %>
        </ul>
      </div>

      <div class="panel expandable">
        <% view.facets.forEach(function (facet, g) {
          var checked = view.filters[facet.key];
        %>
        <input type="checkbox" id="<%= facet.key %>-expand" <%= facet.options.slice(8).some(function (o) { return checked.includes(o.key); }) ? 'checked' : '' %>>
        <details <%= facet.open || checked.length ? 'open' : '' %>>
          <summary>
            <svg class="icon chevron"><use xlink:href="/images/icons.svg#chevron-down"></use></svg>
            <strong><%= facet.name %></strong>
            <small>(<%= facet.options.length %>)</small>
          </summary>
          <% if (facet.options.length > 6) { %>
          <div class="group order-filter-search">
            <svg class="icon"><use xlink:href="/images/icons.svg#search"></use></svg>
            <input type="text" class="prepend-icon" placeholder="Filter <%= facet.name.toLowerCase() %>..." aria-label="Filter <%= facet.name.toLowerCase() %>" data-filter-options>
          </div>
          <% } %>
          <ul class="checkboxes">
            <% facet.options.forEach(function (option, i) { %>
            <li>
              <input type="checkbox" id="<%= facet.key %>-<%= i %>" name="<%= facet.key %>" value="<%= option.key %>" <%= checked.includes(option.key) ? 'checked' : '' %>>
              <label for="<%= facet.key %>-<%= i %>">
                <span><%= option.name %></span>
                <span><%= number(option.count) %></span>
              </label>
            </li>
            <% if (i == 7 && facet.options.length > 8) { %>
            <li class="more"><label for="<%= facet.key %>-expand"><small>(<%= facet.options.length - 8 %>)</small> More options</label></li>
            <% } %>
            <% }); %>
            <% if (facet.options.length > 8) { %>
            <li class="less"><label for="<%= facet.key %>-expand">Less options</label></li>
            <% } %>
          </ul>
        </details>
        <% if (g < view.facets.length - 1) { %><div class="seperator"></div><% } %>
        <% }); %>
      </div>

      <noscript><button type="submit" class="primary">Apply filters</button></noscript>
    </form>

    <% if (view.active) { %>
    <a class="clear-filters" href="<%= view.clearUrl %>">Clear all filters</a>
    <% } %>
  </aside>

  <div class="statistics-section">

    <div class="stat-cards">
      <div class="stat-card notification blue">
        <div class="stat-card-label">Total orders</div>
        <div class="stat-card-value"><%= number(view.total) %></div>
      </div>
      <% view.branches.forEach(function (branch) { %>
      <div class="stat-card notification <%= branch.color %>">
        <div class="stat-card-label"><%= branch.name %></div>
        <div class="stat-card-value"><%= number(branch.count) %></div>
        <div class="stat-card-sub"><%= view.share(branch.count) %></div>
      </div>
      <% }); %>
      <div class="stat-card notification mauve">
        <div class="stat-card-label">Quantity ordered</div>
        <div class="stat-card-value"><%= number(view.quantity) %></div>
      </div>
    </div>

    <section class="statistics-monthly">
      <h3>Orders per month</h3>

      <div class="stat-line-wrap">
        <svg width="100%" viewBox="0 0 <%= chart.width %> <%= chart.height %>" class="stat-line-svg" role="img" aria-label="Orders per month in the last six years; the busiest month had <%= number(chart.highest) %> orders.">
          <% [0, 0.25, 0.5, 0.75, 1].forEach(function (part) { var level = chart.top + chart.innerHeight - part * chart.innerHeight; %>
          <g>
            <line x1="<%= chart.left %>" y1="<%= level %>" x2="<%= chart.left + chart.innerWidth %>" y2="<%= level %>" stroke="currentColor" stroke-opacity="0.08" stroke-width="1"></line>
            <text x="<%= chart.left - 10 %>" y="<%= level + 4 %>" text-anchor="end" font-size="8" opacity="0.45"><%= number(Math.round(part * chart.highest)) %></text>
          </g>
          <% }); %>

          <% view.series.forEach(function (line, s) { %>
          <polyline class="series-<%= s + 1 %>" data-series="<%= line.label %>" points="<%= line.points.map(function (point, i) { return x(i) + ',' + y(point.count); }).join(' ') %>" fill="none" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"></polyline>
          <% }); %>
          <% view.series.forEach(function (line, s) { %>
          <g class="series-<%= s + 1 %>" data-series="<%= line.label %>">
            <% line.points.forEach(function (point, i) { %>
            <circle cx="<%= x(i) %>" cy="<%= y(point.count) %>" r="5"><title><%= line.label %> — <%= point.label %>: <%= number(point.count) %></title></circle>
            <% }); %>
          </g>
          <% }); %>

          <% view.series[5].points.forEach(function (point, i) { if (i % 2 == 0) { %>
          <text x="<%= x(i) %>" y="<%= chart.height - 4 %>" text-anchor="middle" font-size="8.5" opacity="0.5"><%= point.label %></text>
          <% } }); %>
        </svg>

        <ul class="stat-line-legend">
          <% view.series.forEach(function (line, s) { %>
          <li>
            <label>
              <%# Shows and hides a line; without JavaScript there is nothing to tick %>
              <input type="checkbox" checked hidden data-toggle-series="<%= line.label %>">
              <span class="stat-line-dot series-<%= s + 1 %>"></span>
              <span><%= line.label %></span>
            </label>
          </li>
          <% }); %>
        </ul>
      </div>
    </section>

    <div class="statistics-columns">
      <section>
        <h3>Order positions</h3>
        <table class="statistics-table">
          <tbody>
            <% view.byPosition.forEach(function (position) { %>
            <tr>
              <td>
                <span class="tag badge order-position <%= position.color %>"></span>
                <strong><%= position.key %></strong>
                <span class="stat-position-name"><%= position.name %></span>
              </td>
              <td><%= number(position.count) %></td>
              <td class="stat-pct"><%= view.share(position.count) %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </section>

      <section>
        <h3>Order status</h3>
        <div class="stat-bar-list">
          <% view.byStatus.forEach(function (status) { %>
          <div class="stat-bar-row">
            <div class="stat-bar-label"><%= status.key %></div>
            <div class="stat-bar-track"><div class="stat-bar-fill" style="width: <%= (status.count / highestStatus * 100).toFixed(2) %>%"></div></div>
            <div class="stat-bar-count"><%= number(status.count) %></div>
          </div>
          <% }); %>
        </div>
      </section>
    </div>

    <div class="statistics-columns">
      <%- topList('Top products', 'product-period', view.periods.products, view.topProducts, function (item) { return item.title; }) %>
      <%- topList('Top publishers', 'publisher-period', view.periods.publishers, view.topPublishers, function (item) { return item.name; }) %>
    </div>

    <div class="statistics-columns">
      <section>
        <h3>Product groups</h3>
        <div class="stat-bar-list">
          <% view.byGroup.forEach(function (group) { %>
          <div class="stat-bar-row">
            <div class="stat-bar-label"><%= group.key %></div>
            <div class="stat-bar-track"><div class="stat-bar-fill" style="width: <%= (group.count / highestGroup * 100).toFixed(2) %>%"></div></div>
            <div class="stat-bar-count"><%= number(group.count) %></div>
          </div>
          <% }); %>
        </div>
      </section>

      <section>
        <h3>Orders per year (last 10 years)</h3>
        <div class="stat-year-chart">
          <% view.byYear.forEach(function (year) { %>
          <div class="stat-year-col">
            <div class="stat-year-bar-wrap">
              <div class="stat-year-bar" style="height: <%= (year.count / highestYear * 100).toFixed(2) %>%" title="<%= year.year %>: <%= number(year.count) %>"></div>
            </div>
            <div class="stat-year-count"><%= number(year.count) %></div>
            <div class="stat-year-label"><%= year.year %></div>
          </div>
          <% }); %>
        </div>
      </section>
    </div>

  </div>

</main>

<script>
(function () {
  // Apply a filter as soon as it is checked
  var form = document.getElementById("statistics-filters");
  form.addEventListener("change", function (event) {
    if (event.target.name) form.submit();
  });

  // A top list shows another period as soon as it is chosen
  document.querySelectorAll("[data-submit]").forEach(function (select) {
    select.addEventListener("change", function () { select.form.submit(); });
  });

  // The small search field in a long filter hides the options that don't match
  document.querySelectorAll("[data-filter-options]").forEach(function (input) {
    input.addEventListener("input", function () {
      var term = input.value.toLowerCase();
      // While searching, every option that matches shows, also the ones
      // behind "More options"
      input.closest("details").querySelectorAll("li").forEach(function (option) {
        var extra = option.classList.contains("more") || option.classList.contains("less");
        var matches = !extra && option.textContent.toLowerCase().indexOf(term) !== -1;
        option.style.display = !term ? "" : matches ? "block" : "none";
      });
    });
    input.addEventListener("keydown", function (event) {
      if (event.key === "Enter") event.preventDefault();
    });
  });

  // The legend of the line chart shows and hides the lines
  document.querySelectorAll("[data-toggle-series]").forEach(function (box) {
    box.hidden = false;
    box.addEventListener("change", function () {
      document.querySelectorAll('[data-series="' + box.dataset.toggleSeries + '"]').forEach(function (line) {
        line.style.display = box.checked ? "" : "none";
      });
      box.closest("li").classList.toggle("off", !box.checked);
    });
  });
})();
</script>
