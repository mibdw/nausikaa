
<%
  var pageTitle = "Nausikaä";
  var navbar = 'transparent'; 
  // theme is "light", "dark" or "auto" (follow the system setting)
  var themes = [
    { value: 'auto', title: 'Automatic', icon: 'automode' },
    { value: 'light', title: 'Light', icon: 'lightmode' },
    { value: 'dark', title: 'Dark', icon: 'darkmode' }
  ];
  var currentTheme = themes.find(function (t) { return t.value == theme; });

  if (lane == 'frontpage') {
    pageTitle = pageTitle + ", a CSS framework for accessible websites";

  } else if (lane) {
    var li = nav.findIndex(function (l) {
      return l.slug == lane;
    });
    pageTitle = nav[li].title + " \u2014 " + pageTitle;

    if (params.s1) {
      navbar = '';
      var ps1i = nav[li].nav.findIndex(function (ps1) {
        return ps1.slug == params.s1;
      });

      pageTitle = nav[li].nav[ps1i].title + " \u27F8 "+ pageTitle;

      if (params.s2) {
        var ps2i = nav[li].nav[ps1i].nav.findIndex(function (ps2) {
          return ps2.slug == params.s2;
        });

        pageTitle = nav[li].nav[ps1i].nav[ps2i].title + " \u00AB "+ pageTitle;
      }
    }
  }

%>

<!DOCTYPE html>
<html lang="en"<% if (theme != 'auto') { %> data-theme="<%= theme %>"<% } %>>
  <head>

    <meta charset="UTF-8">
    <meta name='viewport' content='width=device-width, initial-scale=1'>

    <title>

      <%= pageTitle; %>

    </title>

    <link rel='icon' sizes='192x192' type='image/png' href='/images/nausikaa.png'>

    <link href='https://fonts.googleapis.com/css?family=IBM+Plex+Mono:300,300i,400,400i,700,700i|IBM+Plex+Sans:300,300i,400,400i,500,500i,700,700i|IBM+Plex+Serif:300,300i,400,400i,700,700i' rel='stylesheet'>
    <link href='/fonts/blokkfont.css' rel='stylesheet' type='text/css'>
    <link rel='stylesheet' href='/styles/nausikaa.min.css'>

    <script src="/scripts/dialog-polyfill.js"></script>

		<% if (theme == 'auto') { %>
		<link rel="stylesheet" href="/styles/github-light.css" media="(prefers-color-scheme: light)">
		<link rel="stylesheet" href="/styles/github-dark.css" media="(prefers-color-scheme: dark)">
		<% } else { %>
		<link rel="stylesheet" href="/styles/github-<%= theme %>.css">
		<% } %>
		<script src="/scripts/highlight.min.js"></script> 
		<script>hljs.highlightAll();</script>

  </head>
  <body ontouchstart="">
    <header class="navbar <%= navbar %>">

      <a href="/" id="brand" title="Nausikaä">
        <img src="/images/nausikaa.png" alt="">
      </a>
       
      <input type="checkbox" class="navbar-toggle" id="navbar-toggler">  
      <label for="navbar-toggler">
        <svg class="icon menu">
          <use xlink:href="/images/icons.svg#hamburger"></use>
        </svg>
        <svg class="icon close">
          <use xlink:href="/images/icons.svg#clear"></use>
        </svg>
      </label>

      <nav>
        <ul class="knobs">
          <% nav.forEach(n => { 
            if (n.slug != 'download') {
              if (n.slug == 'examples') {
                %>
                  <li class="<%= n.slug == lane ? 'active' : '' %> dropdown">
                    <a tabindex="0" alt="<%= n.title %>">
                      <%= n.title %>
                      <% n.nav.forEach(o => { %>
                        <% if (o.slug == params.s1) { %>
                          <small style="opacity: .75;">/ <%= o.title %></small>
                        <% } %>
                      <% }); %>
                      <svg class="icon last">
                        <use xlink:href="/images/icons.svg#chevron-down"></use>
                      </svg>                      
                    </a>
                    <nav class="panel arrow">
                      <ul>
                        <% n.nav.forEach(o => { %>
                          <li class="<%= o.slug == params.s1 ? 'active' : '' %>">
                            <a href="/<%= n.slug %>/<%= o.slug %>" title="<%= o.title %>" style="padding-right: 3em;"><%= o.title %></a>
                          </li>
                        <% }); %>
                      </ul>
                    </nav>

                  </li>
                <%

              } else {

                %>
                  <li class="<%= n.slug == lane ? 'active' : '' %>">
                    <a href="/<%= n.slug %>" alt="<%= n.title %>"><%= n.title %></a>
                  </li>
                <%
              }
           }

          }); %>
        </ul>
      </nav>

      <div class="spacer"></div>

<!--       <div class="suggestions">
        <div class="group">
          <svg class="icon">
            <use xlink:href="/images/icons.svg#search"></use>
          </svg>
          <input type="search" class="prepend-icon" value="Search..." id="suggestions-2">
        </div>  
        <div class="panel">
          <ul>
            <li><a href="">Lorem ipsum dolor sit amet</a></li>
            <li><a href="">Earum soluta eum cum iure atque</a></li>
            <li><a href="">Facere reprehenderit voluptatibus</a></li>
            <li><a href="">Deleniti aut labore, consequatur</a></li>
            <li><a href="">Repellendus tenetur</a></li>
          </ul>
        </div>
      </div> -->

      <nav>
        <ul>
          <li><a href="/download" alt="Download">Download</a></li>
          <li><a href="https://github.com/mibdw/nausikaa" alt="Github">Github</a></li>
        </ul>
      </nav>

      <form action="/theme-switch" method="POST" class="theme-switcher dropdown">
        <button type="button" class="secondary" aria-label="Theme: <%= currentTheme.title %>" title="Theme: <%= currentTheme.title %>">
          <svg class="icon">
            <use xlink:href="/images/icons.svg#<%= currentTheme.icon %>"></use>
          </svg>
        </button>
        <nav class="panel arrow top right" aria-label="Theme">
          <ul>
            <% themes.forEach(function (t) { %>
            <li class="<%= t.value == theme ? 'active' : '' %>">
              <button type="submit" name="theme" value="<%= t.value %>" class="link" <%= t.value == theme ? 'aria-current=true' : '' %>>
                <svg class="icon">
                  <use xlink:href="/images/icons.svg#<%= t.icon %>"></use>
                </svg>
                <%= t.title %>
              </button>
            </li>
            <% }); %>
          </ul>
        </nav>
      </form>

      
    </header>
    
    <%- include(lane + '/index', { nav: nav, lane: lane, params: params }); %>
  
  </body>
</html>
