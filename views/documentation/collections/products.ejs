				</div>

				<footer class="product-controls">
					
					<button class="small">
						<svg class="icon">
							<use xlink:href="/images/icons.svg#cart"></use>
						</svg>
					</button>

					<div class="spacer"></div>

					<h6><span class="price">&#8364;112.50</span></h6>
				</footer>
			</li>
			
			<li class="product card bordered">

